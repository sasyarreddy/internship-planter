{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "internship-planter",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "internship-planter-db",
      // Replace with the database_id printed by: npx wrangler d1 create internship-planter-db
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
